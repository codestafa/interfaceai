# Default-deny build context. Keep private kit content and local configuration out.
**
!Dockerfile
!.dockerignore
!harness/
!harness/contract.py
!backend/
!backend/__init__.py
!backend/requirements.txt
!backend/submission/
!backend/submission/**/
!backend/submission/**/*.py
!backend/server/
!backend/server/*.py
!scripts/
!scripts/import_kit.py
!frontend/
!frontend/package.json
!frontend/package-lock.json
!frontend/index.html
!frontend/tsconfig.json
!frontend/vite.config.ts
!frontend/src/
!frontend/src/**/
!frontend/src/**/*.ts
!frontend/src/**/*.tsx
!frontend/src/**/*.css
!frontend/public/
!frontend/public/favicon.svg
